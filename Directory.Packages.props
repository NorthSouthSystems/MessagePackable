<Project>
    <PropertyGroup>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

        <DotNetVersion>10.0.14</DotNetVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
        <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
        <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
        <PackageVersion Include="Nerdbank.MessagePack" Version="1.4.95" />
        <!-- NorthSouthSystems.Opinions.BCL: Run the T4 template to update! -->
        <PackageVersion Include="NorthSouthSystems.Text" Version="8.0.1" />
        <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
        <PackageVersion Include="System.IO.Hashing" Version="$(DotNetVersion)" />
        <PackageVersion Include="xunit.v3" Version="4.0.2" />

        <!-- Transitive Pinning -->
        <!-- This will help prevent large(r) potentially breaking version bumps, and it will also -->
        <!-- allow us to benefit from potential performance improvements to newer package versions. -->
        <!-- In some cases, transitive pinning is necessary due to an unexplicable error, likely related to -->
        <!-- explicit nuget.config package mapping (which we have since relaxed with a catch-all pattern): -->
        <!-- NU1102 "Unable to find package ... with version (>= [a valid version])" -->

        <!-- NuGet.Protocol -->
        <!-- 8.0.1 has a known high severity vulnerability, https://github.com/advisories/GHSA-846f-f764-76mx -->
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(DotNetVersion)" />
    </ItemGroup>
</Project>
